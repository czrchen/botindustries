---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="brand">
        <span class="brand-mark">BOT</span>
        <span class="brand-text">Industries</span>
      </a>
      <p>A leading manufacturer &amp; exporter of halal 3-in-1 premix beverages — your recipe, our line. OEM &amp; private label, Malaysia.</p>
      <div class="socials">
        <a href="#" aria-label="Facebook">Facebook</a>
        <a href="#" aria-label="LinkedIn">LinkedIn</a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <a href="/">Home</a>
      <a href="/about">About Us</a>
      <a href="/products">Products</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <h4>Beverages</h4>
      <a href="/products">3-in-1 Coffee</a>
      <a href="/products">White Coffee</a>
      <a href="/products">Milk Tea &amp; Chocolate</a>
      <a href="/products">Cereal &amp; Ginger</a>
    </div>

    <div class="footer-col">
      <h4>Get in touch</h4>
      <p class="muted">Halal premix beverage manufacturer &amp; OEM · Malaysia</p>
      <a href="mailto:enquiry@botindustries.com.my">enquiry@botindustries.com.my</a>
      <a href="/contact">Request OEM quote →</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} BOT Industries International Sdn Bhd</span>
    <span>Halal Premix Beverages · Malaysia</span>
  </div>
</footer>

<style>
  .footer { position: relative; background: var(--ink); color: #CDC4B6; margin-top: 110px; padding: 70px 0 30px; }
  .footer-inner { display: grid; grid-template-columns: 1.7fr 1fr 1fr 1.4fr; gap: 40px; }
  .brand { display: flex; align-items: center; gap: 9px; margin-bottom: 18px; }
  .brand-mark {
    display: grid; place-items: center; padding: 0 11px; height: 42px;
    background: var(--red); color: #fff; border-radius: 12px;
    font-family: var(--font-display); font-weight: 800; font-size: 1.2rem;
  }
  .brand-text { font-family: var(--font-display); font-weight: 600; font-size: 1.1rem; color: #fff; }
  .footer-brand p { color: #9A8E7C; max-width: 330px; font-size: .95rem; line-height: 1.6; }

  .socials { display: flex; gap: 18px; margin-top: 22px; }
  .socials a { font-size: .88rem; font-weight: 500; color: #9A8E7C; transition: color .2s ease; }
  .socials a:hover { color: var(--gold); }

  .footer-col h4 {
    font-family: var(--font-display); font-size: .8rem; letter-spacing: .12em; text-transform: uppercase;
    margin-bottom: 18px; color: #7A6E5C;
  }
  .footer-col a { display: block; color: #CDC4B6; padding: 6px 0; font-size: .95rem; transition: color .18s ease; }
  .footer-col a:hover { color: #fff; }
  .footer-col .muted { color: #9A8E7C; margin-bottom: 14px; font-size: .95rem; line-height: 1.6; }

  .footer-bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
    margin-top: 54px; padding-top: 26px;
    border-top: 1px solid rgba(255,255,255,.08);
    color: #7A6E5C; font-size: .86rem;
  }

  @media (max-width: 860px) { .footer-inner { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer-inner { grid-template-columns: 1fr; gap: 30px; } }
</style>
